# Memora Environment Variables
# Copy this file to .env and fill in your values.
# DO NOT commit .env to git.

# Required: Your deployed Cloudflare Workers RAG backend
RAG_WORKER_URL=https://your-worker.your-subdomain.workers.dev
RAG_AUTH_TOKEN=your_secret_token_here

# Optional: Override default paths
# HERMES_HOME=$HOME/.hermes
# MEMORA_WORKSPACE=$HOME/hermes-workspace

# Optional: Kanban backend (hermes | linear | none)
# MEMORA_KANBAN_BACKEND=hermes

# Optional: Tunnel provider for webhook ingress (cloudflared | ngrok | localtunnel | none)
# MEMORA_TUNNEL=cloudflared

# Optional: Daemon port
# MEMORA_DAEMON_PORT=8742
