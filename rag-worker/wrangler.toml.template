# Memora RAG Worker — Wrangler Configuration Template
#
# 1. Copy this file to wrangler.toml
# 2. Fill in your database_id and kv_namespaces id
# 3. Set AUTH_TOKEN via: wrangler secret put AUTH_TOKEN
#
# DO NOT commit wrangler.toml with real secrets to git.

name = "hermes-rag"
main = "src/index.js"
compatibility_date = "2024-09-23"

[ai]
binding = "AI"

[[vectorize]]
binding = "VECTORIZE"
index_name = "hermes-kb"

[[d1_databases]]
binding = "DB"
database_name = "hermes-memory"
database_id = "YOUR_DATABASE_ID_HERE"

[[kv_namespaces]]
binding = "CACHE"
id = "YOUR_KV_NAMESPACE_ID_HERE"

[vars]
DEFAULT_LLM = "@cf/meta/llama-4-scout-17b-16e-instruct"
EMBEDDING_MODEL = "@cf/baai/bge-m3"
RERANKER_MODEL = "@cf/baai/bge-reranker-base"
# AUTH_TOKEN is set via: wrangler secret put AUTH_TOKEN
